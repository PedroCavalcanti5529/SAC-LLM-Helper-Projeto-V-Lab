# Provedor: fake (sem chave, respostas fixas) ou gemini (Google AI Studio, free tier)
LLM_PROVIDER=
# Chave do Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo (padrão: gemini-3.5-flash-lite)
LLM_MODEL=
# Parâmetros de geração (padrões: 0.2 / 4096 / 60)
LLM_TEMPERATURE=
LLM_MAX_OUTPUT_TOKENS=
LLM_TIMEOUT_SECONDS=
# Retry em falha temporária do provedor (429, 5xx, timeout, conexão) com backoff exponencial + jitter
# (padrões: 3 repetições / base de 2 segundos; 0 repetições desliga)
LLM_MAX_RETRIES=
LLM_BACKOFF_BASE_SECONDS=
# Onde gravar history.json, cache.json e runs/ (padrão: outputs/)
OUTPUT_DIR=
